# 실제 운영 값은 Vercel 프로젝트(very)의 환경변수에 있다.
# 로컬은 레이아웃 확인용 더미로 충분하며, 더미면 DB 데이터가 붙지 않은
# 폴백 화면이 렌더된다. (RESEND_API_KEY는 모듈 로드 시 존재만 검사)
NEXT_PUBLIC_SUPABASE_URL=https://dummy-local.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dummy-anon-key
SUPABASE_SERVICE_ROLE_KEY=dummy-service-key
RESEND_API_KEY=re_dummy

# 선택: 검색엔진 소유 확인 메타 태그
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
